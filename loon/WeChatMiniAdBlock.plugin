#!name= 微信小程序广告拦截（抓包 122）
#!desc= 按 2026-09-04 抓包 122_1788505940449 中的明文广告流量编写。拦截激励视频 ads_svp_video、试玩广告 playable/wxapkg、广告 SDK 上报。不碰 mmtls，避免搞挂微信。
#!author= local
#!openUrl= https://servicewechat.com/wx39923e171e63acf4/13/page-frame.html
#!homepage= https://servicewechat.com/wx39923e171e63acf4/13/page-frame.html

# 对应抓包：
#   AppID     wx39923e171e63acf4  v13
#   广告位    adunit-263dcea2cde86153
#   试玩包    wx28a4f4446d1676f7 / playable.qpic.cn/wxdf37072dc5be7fd0/3.wxapkg
#   视频 pos  3030046789020061 / 4071202390577885 / 5060180989186180
#
# 用法：Loon → 插件 → 添加本地插件 → 选这个文件 → 开启 MitM 和 Rewrite。
# 若微信提示证书失败，只保留 [Rule] 里的域名拦截，把 [MITM] 里 wxs.qq.com 相关 hostname 删掉。

[Rule]
# 试玩广告主站（抓包里 3.wxapkg 的源站）
DOMAIN,playable.qpic.cn,REJECT
# 广告 SDK 上报（visit / WeInnerAd / ad_traffic_split）
DOMAIN,report-online.sh.wxgateway.com,REJECT-DICT

[Rewrite]
# ---------- 激励视频 / 封面（抓包核心） ----------
# wxsmw.wxs.qq.com 本次 28 条全是 ads_svp_video_*.mp4
^https?:\/\/wxsmw\.wxs\.qq\.com\/.+ads_svp_video_ - reject
# 同一批广告的封面 jpeg
^https?:\/\/wximg\.wxs\.qq\.com\/.+ads_svp_video_ - reject

# ---------- 试玩广告包 ----------
^https?:\/\/playable\.qpic\.cn\/ - reject
# 302 之后的 cdntips 节点，host 会变，按路径拦
^https?:\/\/[^\/]*cdntips\.net\/playable\.qpic\.cn\/ - reject
# 试玩小程序代码包 busi_id=1005 / app=wx28a4f4446d1676f7
^https?:\/\/prewxacode\.wxqcloud\.qq\.com\.cn\/weapp\/release_encrypt\/.*(busi_id=1005|app=wx28a4f4446d1676f7) - reject

# ---------- 广告 SDK 上报 ----------
^https?:\/\/report-online\.sh\.wxgateway\.com\/SdkReport - reject-dict

# ---------- 广告 UI 皮（拦素材后残留图标） ----------
^https?:\/\/wxa\.wxs\.qq\.com\/images\/wxapp\/(playable-|reward_ad_|reward-video-|drama_reward_) - reject
^https?:\/\/wxa\.wxs\.qq\.com\/images\/skit\/drama_reward_ - reject

[MITM]
hostname = playable.qpic.cn,wxsmw.wxs.qq.com,wximg.wxs.qq.com,wxa.wxs.qq.com,report-online.sh.wxgateway.com,prewxacode.wxqcloud.qq.com.cn,*.cdntips.net
